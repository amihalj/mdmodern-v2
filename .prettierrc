{
  "useTabs": false,
  "tabWidth": 2,
  "singleQuote": true,
  "trailingComma": "none",
  "printWidth": 180,
  "plugins": ["prettier-plugin-svelte"],
  "pluginSearchDirs": ["."],
  "overrides": [{ "files": "*.svelte", "options": { "parser": "svelte" } }],
  "semi": false,
  "svelteAllowShorthand": true,
  "bracketSameLine": false,
  "svelteBracketNewLine": false,
  "proseWrap": "always"
}
